<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="780.0" spacing="16.0" styleClass="glass-panel" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.moafogaus.controller.FileBrowserDialogController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="app-title" style="-fx-font-size: 18px;" text="Explorateur &amp; Importation Multimédia" />
            <Label styleClass="item-meta" text="Saisissez un chemin de dossier ou naviguez pour sélectionner plusieurs fichiers" />
        </VBox>
        <Button onAction="#handleClose" styleClass="btn-icon" text="✕" textFill="#94a3b8" />
    </HBox>

    <!-- Navigation & Address Bar -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Button onAction="#handleGoUp" styleClass="btn-secondary" text="⬆ Dossier parent" />
            <TextField fx:id="addressBarField" onAction="#handleAddressBarNavigate" promptText="Entrez un chemin de dossier (ex: /home/utilisateur/Vidéos)" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleAddressBarNavigate" styleClass="btn-primary" style="-fx-font-size: 13px; -fx-padding: 6 14 6 14;" text="Aller ➔" />
        </HBox>

        <!-- Quick Location Shortcuts -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="item-meta" text="Accès rapide :" />
            <Button onAction="#handleQuickHome" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10 4 10;" text="🏠 Accueil" />
            <Button onAction="#handleQuickMusic" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10 4 10;" text="🎵 Musique" />
            <Button onAction="#handleQuickVideos" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10 4 10;" text="🎬 Vidéos" />
            <Button onAction="#handleQuickDownloads" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 10 4 10;" text="📥 Téléchargements" />
        </HBox>
    </VBox>

    <!-- File List View -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <CheckBox fx:id="selectAllCheckBox" onAction="#handleSelectAllToggle" text="Tout Sélectionner" styleClass="item-title" style="-fx-font-size: 13px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="fileCountLabel" styleClass="item-meta" text="0 fichier multimédia trouvé" />
        </HBox>

        <ListView fx:id="fileListView" styleClass="scroll-pane" VBox.vgrow="ALWAYS" />
    </VBox>

    <!-- Footer Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button onAction="#handleClose" styleClass="btn-secondary" text="Annuler" />
        <Button fx:id="importSelectedBtn" onAction="#handleImportSelected" styleClass="btn-primary" text="⚡ Importer les fichiers sélectionnés (0)" />
    </HBox>
</VBox>
