<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" spacing="14" styleClass="item-card" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.moafogaus.controller.MediaItemRowController">
    <!-- Format Badge / Icon -->
    <VBox alignment="CENTER" prefWidth="70" spacing="3">
        <Label fx:id="inputFormatBadge" styleClass="format-badge" text="MP4" />
        <Label fx:id="sizeLabel" styleClass="item-meta" text="12.4 MB" />
    </VBox>

    <!-- File Information & Progress -->
    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="6">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="titleLabel" styleClass="item-title" text="video_vacances_2026.mp4" />
            <Label fx:id="durationLabel" styleClass="item-meta" text="• 03:45" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusBadgeLabel" styleClass="badge-status" style="-fx-font-size: 10px; -fx-padding: 2 8 2 8;" text="En attente" />
        </HBox>
        
        <!-- Progress bar and status info -->
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="statusMessageLabel" styleClass="item-meta" style="-fx-text-fill: #e2e8f0; -fx-font-weight: bold;" text="Prêt" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="etaLabel" styleClass="item-meta" text="" />
            </HBox>
            <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0" prefHeight="8" />
        </VBox>
    </VBox>

    <!-- Per-item Target Format Chooser -->
    <VBox alignment="CENTER" spacing="2">
        <Label text="Format" styleClass="item-meta" />
        <ComboBox fx:id="targetFormatCombo" prefWidth="125" />
    </VBox>

    <!-- Actions -->
    <HBox alignment="CENTER" spacing="6">
        <Button fx:id="settingsBtn" onAction="#handleOpenSettings" styleClass="btn-icon" text="⚙" textFill="#94a3b8" />
        <Button fx:id="openOutputBtn" onAction="#handleOpenOutput" visible="false" managed="false" styleClass="btn-secondary" text="📁 Ouvrir" />
        <Button fx:id="removeBtn" onAction="#handleRemove" styleClass="btn-icon" text="✕" textFill="#ef4444" />
    </HBox>
</HBox>
